# LLM Provider Configuration
# Supported: gemini, ollama
LLM_PROVIDER=gemini

# Gemini Cloud Settings (Free Tier)
GEMINI_API_KEY=your-gemini-api-key-here
# Run 'python -m backend.llm.check' with your key to list available models and recommendations (e.g. gemini-2.0-flash)
GEMINI_MODEL=

# Ollama Local Settings (Low-End Hardware / Offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_FAST_MODEL=qwen2.5:3b

# Rate Limiting (Gemini free tier: max 15 RPM, default 10 RPM)
RATE_LIMIT_RPM=10

# Demo Mode (true = allow mock content with visible "DEMO DATA" watermark; false = require valid provider/key)
DEMO_MODE=false

# Whisper Speech-to-Text Configuration
# Models: tiny, base, small, medium, large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=4

# Server Settings
HOST=0.0.0.0
PORT=8000

# File Cleanup & Upload Limits
CLEANUP_AFTER_HOURS=24
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_MIN=180
